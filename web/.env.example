# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Database (Turso) ----------------------------------------------------------
# Leave unset in development to use a local SQLite file (web/local.db).
# Production: `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth (Better Auth) --------------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=
# Public site URL, e.g. https://zaphira.dz (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000

# First admin account, created by `npm run db:seed` if it doesn't exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (verification codes, order confirmations) ---------------------------
# Without a key, emails are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Maison Zaphira <contact@your-domain>"

# --- Image uploads from the admin (Vercel Blob) --------------------------------
# Without a token, uploads are saved to web/public/uploads (development only).
BLOB_READ_WRITE_TOKEN=

# --- CodPilot (order hand-off) -------------------------------------------------
# Leave empty until CodPilot's order API details are available; orders are then
# stored locally with codpilot_status = 'disabled'.
CODPILOT_API_URL=
CODPILOT_API_KEY=
